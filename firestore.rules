rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // SCHOOL SETTINGS collection
    match /school_settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // USERS collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // TEACHERS collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isValidId(teacherId);
    }

    // TEACHER ASSIGNMENTS collection (Wali Kelas)
    match /teacher_assignments/{assignmentId} {
      allow read: if true;
      allow write: if isValidId(assignmentId);
    }

    // CLASSES collection
    match /classes/{classId} {
      allow read: if true;
      allow write: if isValidId(classId);
    }

    // STUDENTS collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if isValidId(studentId);
    }

    // DAILY REPORTS collection
    match /daily_reports/{reportId} {
      allow read: if true;
      allow write: if isValidId(reportId);
    }

    // ATTENDANCE collection
    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if isValidId(attendanceId);
    }

    // AUDIT LOGS collection
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }
  }
}

